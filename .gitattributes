# Normalize line endings: LF in repo, CRLF on Windows checkout
* text=auto eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.py   text eol=lf
*.svg  text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.mp4  binary
*.webm binary
*.zip  binary
